---
import { Icon } from "astro-icon/components";
import mixgit_desktop from "../assets/mixgit_desktop.png";

const stack = [
  { label: "Next.js", icon: "simple-icons:nextdotjs" },
  { label: "MongoDB/Mongoose", icon: "simple-icons:mongodb" },
  { label: "Anthropic Claude", icon: "simple-icons:claude" },
];
---

<section id="projects" class="mx-auto w-full max-w-5xl px-4 py-12">
  <h2 class="reveal mb-8 text-2xl font-bold tracking-tight">
    Featured project
  </h2>
  <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
    <div
      class="mockup-browser border-base-300 bg-base-200 w-full border lg:flex-1"
    >
      <div class="mockup-browser-toolbar">
        <div class="input">https://mixgit.tech/adonis/welcome-to-mixgit</div>
      </div>
      <img
        src={mixgit_desktop.src}
        alt="Mixgit app screenshot"
        class="w-full"
      />
    </div>
    <div class="flex w-full flex-col gap-3 lg:max-w-md lg:flex-1">
      <h3 class="text-xl font-bold tracking-tight">Mixgit</h3>
      <p class="text-base-content/70">
        Full-stack collaboration & AI code-review platform for Scratch.
      </p>
      <div class="mt-1 flex flex-wrap gap-2">
        {
          stack.map((tech) => (
            <span class="badge border-base-300 bg-base-100 text-base-content gap-1.5 font-medium">
              <Icon name={tech.icon} class="text-base-content/70 size-3.5" />
              {tech.label}
            </span>
          ))
        }
      </div>
      <p class="mt-3">
        Mixgit brings Git-style version control to MIT Scratch block coding.
        Students share their work as "Remixes," a student-friendly take on
        branches and pull requests. Then, Claude reads the underlying block
        logic to give beginner-friendly code review to both students and
        instructors.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          class="btn btn-primary btn-sm"
          href="https://mixgit.tech/adonis"
          target="_blank">Live demo</a
        >
        <a
          class="btn btn-outline btn-sm"
          href="/blog/teaching-claude-to-read-block-code/"
          >Read the write-up</a
        >
        <a
          class="btn btn-ghost btn-sm"
          href="https://github.com/HunterCogan/mixgit"
          target="_blank">Repo</a
        >
      </div>
    </div>
  </div>
  <div class="mt-10 flex justify-center">
    <a
      href="https://github.com/adoniscanada"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-sm"
      >More on GitHub <Icon name="tabler:arrow-narrow-right" class="size-4" /></a
    >
  </div>
</section>
