---
import heroImage from "../assets/hero.jpg";
---

<section class="hero min-h-[70vh]">
  <div class="hero-content w-full max-w-5xl px-4 py-16">
    <div
      class="flex w-full flex-col-reverse items-center gap-10 md:flex-row md:items-center md:justify-between"
    >
      <div
        class="flex max-w-2xl flex-col items-center gap-5 text-center md:items-start md:text-left"
      >
        <h1 class="text-4xl font-bold tracking-tighter md:text-5xl">
          CS graduate building <span class="text-primary">secure</span> and thoughtful
          software.
        </h1>
        <p class="text-base-content/70 max-w-prose text-lg">
          I build full-stack and AI tools, and teach the next generation of
          developers. UConn CS, Cybersecurity concentration.
        </p>
        <div class="mt-2 flex flex-wrap justify-center gap-3 md:justify-start">
          <a href="#projects" class="btn btn-primary">View projects</a>
          <a href="#contact" class="btn btn-outline">Contact</a>
        </div>
      </div>
      <img
        src={heroImage.src}
        alt="Adonis Canada"
        class="ring-primary/40 ring-offset-base-100 w-40 shrink-0 rounded-full ring-2 ring-offset-4 md:w-52"
      />
    </div>
  </div>
</section>
