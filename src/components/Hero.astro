---
import heroImage from "../assets/hero.jpg";
---

<section class="hero min-h-[70vh]">
  <div class="hero-content py-16">
    <div class="flex max-w-2xl flex-col items-center gap-5 text-center">
      <img
        src={heroImage.src}
        alt="Adonis Canada"
        class="ring-base-300 w-36 rounded-full ring-2 ring-offset-2 ring-offset-base-100"
      />
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
        CS graduate building secure and thoughtful software.
      </h1>
      <p class="text-base-content/70 max-w-prose text-lg">
        Full-stack & AI solutions · University of Connecticut, Cybersecurity
        concentration.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <a href="#projects" class="btn btn-primary">View projects</a>
        <a href="#contact" class="btn btn-outline">Contact me</a>
      </div>
    </div>
  </div>
</section>
